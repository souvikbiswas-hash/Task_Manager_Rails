<h1><%= @task.title %></h1>

<p>
  <strong>Description:</strong>
  <%= @task.description %>
</p>

<p>
  <strong>Status:</strong>
  <%= @task.status %>
</p>

<p>
  <strong>Created:</strong>
  <%= @task.created_at %>
</p>

<p>
  <strong>Assigned User:</strong>
  <%= @task.user.name %>
</p>

<p>
  <strong>Email:</strong>
  <%= @task.user.email %>
</p>

<br>

<%= link_to "Edit Task", "/tasks/#{@task.id}/edit" %>

<br><br>

<%= button_to "Delete Task",
              "/tasks/#{@task.id}",
              method: :delete,
              data: { turbo_confirm: "Are you sure you want to delete this task?" } %>

<br>

<%= link_to "Back to Tasks", "/tasks" %>