<h1>Edit Task</h1>

<% if @task.errors.any? %>
  <div>
    <% @task.errors.full_messages.each do |message| %>
      <p><%= message %></p>
    <% end %>
  </div>
<% end %>

<%= form_with model: @task, url: "/tasks/#{@task.id}", method: :patch do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title, required: true %>
  </div>

  <br>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <br>

  <div>
    <%= form.label :status %>
    <%= form.select :status,
          ["", "Pending", "In Progress", "Completed"] %>
  </div>

  <br>

<div>
  <%= form.label :priority %>
  <%= form.select :priority,
        ["", "Low", "Medium", "High"] %>
</div>
<br>

  <%= form.submit "Update Task" %>
<% end %>

<br>

<%= link_to "Back to Task", "/tasks/#{@task.id}" %>